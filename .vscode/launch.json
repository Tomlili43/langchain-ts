{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "nanobot gateway (launch)",
      "type": "debugpy",
      "request": "launch",
      "module": "nanobot",
      "args": ["gateway", "--foreground", "-v"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": false
    },
    {
      "name": "nanobot gateway (attach 5678)",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "127.0.0.1", "port": 5678 },
      "justMyCode": false
    },
    {
      "name": "pytest current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-s", "-vv"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python"
    }
  ]
}
